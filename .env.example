VISITOR_DB_PASSWORD=replace-with-a-local-secret
VISITOR_RABBITMQ_PASSWORD=replace-with-a-local-secret
VISITOR_BOOTSTRAP_USERNAME=system-admin
VISITOR_BOOTSTRAP_PASSWORD=replace-before-starting
VISITOR_GUARD_PASSWORD=replace-before-starting
VISITOR_DORM_PASSWORD=replace-before-starting
VISITOR_ADMIN_PASSWORD=replace-before-starting
VISITOR_INTERNAL_TOKEN=replace-with-an-internal-service-secret
VISITOR_JWT_SECRET=replace-with-at-least-32-characters-jwt-secret
# Q-006 确认前保持 UNDECIDED；确认后只能设置 REQUIRED 或 OPTIONAL。
# 本地联调用 oa-mock；接入真实 OA 后替换。
OA_PROFILE=oa-mock
# Q-008/Q-012 确认前保持 UNDECIDED。
GUARD_VISIBILITY_MODE=UNDECIDED
DORMITORY_SCOPE_MODE=UNDECIDED
